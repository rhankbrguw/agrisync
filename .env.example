# Application
APP_ENV=development
APP_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,https://agrisync.vercel.app,https://agrisync.rhankbrguw.xyz

# Supabase (Database, Auth & Storage)
# Local: http://127.0.0.1:54321 | Prod: https://your-project.supabase.co
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Resend Configuration (Email Delivery & Webhooks)
RESEND_API_KEY="re_your_resend_api_key_here"
RESEND_FROM="notifications@rhankbrguw.xyz"
RESEND_FROM_NAME="AgriSync"

# Payment Gateway (Midtrans Snap)
VITE_MIDTRANS_CLIENT_KEY=your_midtrans_client_key_here
MIDTRANS_SERVER_KEY=your_midtrans_server_key_here

# Map Provider (Optional - defaults to OpenStreetMap if empty)
VITE_MAPTILER_API_KEY=
